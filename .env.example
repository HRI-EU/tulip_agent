# Copy this file to .env and adjust the values for your provider.

# Supported values: openai, azure, oai_compatible
TULIP_MODEL_SERVE_MODE=oai_compatible

# Chat model used by agents unless a constructor argument overrides it.
TULIP_BASE_MODEL=llama3.2

# Embedding model used by ToolLibrary semantic search unless overridden.
TULIP_EMBEDDING_MODEL=mxbai-embed-large

# Optional. Agents fall back to TULIP_BASE_MODEL when no reasoning model is set.
TULIP_REASONING_MODEL=

# OpenAI-compatible local endpoint, for example Ollama.
OAI_COMPATIBLE_BASE_URL=http://localhost:11434/v1

# Optional for local endpoints. Tulip defaults to EMPTY when this is unset.
OAI_COMPATIBLE_API_KEY=EMPTY

# OpenAI
# OPENAI_API_KEY=

# Azure OpenAI
# AZURE_OPENAI_API_KEY=
# AZURE_API_VERSION=
# AZURE_OPENAI_ENDPOINT=
